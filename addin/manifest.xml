<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">

  <Id>8f2c1b7e-3a41-4d9b-9f6a-2d4c5e6f7a10</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Hermes Agent (local bridge)</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="Hermes"/>
  <Description DefaultValue="Hermes Agent внутри Excel: любые модели, инструменты, общая сессия с desktop/web."/>
  <IconUrl DefaultValue="https://localhost:3443/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3443/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3443/taskpane.html"/>
  <AppDomains>
    <AppDomain>https://localhost:3443</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3443/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Hermes.Group">
                <Label resid="Hermes.GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="Hermes.Button">
                  <Label resid="Hermes.Button.Label"/>
                  <Supertip>
                    <Title resid="Hermes.Button.Label"/>
                    <Description resid="Hermes.Button.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>HermesPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:3443/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://localhost:3443/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://localhost:3443/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3443/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3443/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Hermes.GroupLabel" DefaultValue="Hermes Agent"/>
        <bt:String id="Hermes.Button.Label" DefaultValue="Hermes"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Hermes.Button.Tip" DefaultValue="Открыть Hermes: любые модели, агент с инструментами, сессия общая с desktop и web."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
